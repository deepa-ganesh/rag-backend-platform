# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================

# Common
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
API_KEY=dev-ragchat-api-key
CACHE_TTL=10
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_TIME_WINDOW=300
JDK_JAVA_OPTIONS=-Xms512m -Xmx1024m
CORS_ALLOWED_ORIGINS=https://dev.ragchat.example.com
ENCRYPTION_KEY=change-me-dev-base64-key
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m


# PostgreSQL
POSTGRES_DB=ragchatstoredev
POSTGRES_USER=ragchat_dev
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-DevPa55word!}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_IMAGE=postgres:17
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_VOLUME=/var/lib/postgresql/data


# pgAdmin
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_PORT=5050
PGADMIN_IMAGE=dpage/pgadmin4
PGADMIN_DEFAULT_EMAIL=postgres@dev.example.com
PGADMIN_DEFAULT_PASSWORD=${PGADMIN_DEFAULT_PASSWORD:-DevAdminPass!}


# Spring Data Source
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ragchatstoredev
SPRING_DATASOURCE_USERNAME=ragchat_dev
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-DevPa55word!}
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect


# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_CHAT_MESSAGES=chat_messages_dev


# Redis
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_CONTAINER_NAME=redis
REDIS_VOLUME=/data
REDIS_IMAGE=redis:7


# ELK (Elasticsearch, Logstash, Kibana) Stack
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_CONTAINER_NAME=elasticsearch
ELASTIC_PORT=9200
ELASTIC_VOLUME=/usr/share/elasticsearch/data
ELASTIC_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.12.2

LOGSTASH_HOST=logstash
LOGSTASH_PORT=5001
LOGSTASH_CONTAINER_NAME=logstash
LOGSTASH_IMAGE=docker.elastic.co/logstash/logstash:8.12.2

KIBANA_URL=http://kibana:5601
KIBANA_CONTAINER_NAME=kibana
KIBANA_PORT=5601
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.12.2


# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=chatstorage-service-dev
OTEL_CONTAINER_NAME=otel-collector
OTEL_PORT=4318
OTEL_IMAGE=otel/opentelemetry-collector-contrib:latest


# Eureka
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-service:8761/eureka


# Config Server
SPRING_CONFIG_IMPORT=optional:configserver:http://config-server:8888
