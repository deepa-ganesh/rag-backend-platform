# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================

# ----------------------------
# Spring Boot Configuration
# ----------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# API & Rate Limiting
API_KEY_SECRET=dev-api-key-456
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_TIME_WINDOW=1m

# ----------------------------
# PostgreSQL Configuration
# ----------------------------
POSTGRES_DB=rag_chat_dev
POSTGRES_USER=xdai_dev
# Use a strong password in local and production environments
POSTGRES_PASSWORD=devpassword

# Spring DataSource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rag_chat_dev
SPRING_DATASOURCE_USERNAME=xdai_dev
SPRING_DATASOURCE_PASSWORD=devpassword
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ----------------------------
# Redis Configuration
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ----------------------------
# Kafka Configuration
# ----------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_CHAT_MESSAGES=chat_messages_dev

# ----------------------------
# Observability & Monitoring
# ----------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5001
KIBANA_URL=http://kibana:5601
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=chatstorage-service-dev
