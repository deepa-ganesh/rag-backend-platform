# ===========================================================
#  RAG Chat Storage Microservice – Environment Configuration
# ===========================================================

# -------------------------------
# Application Settings
# -------------------------------
# Spring profile: local | dev | prod
SPRING_PROFILES_ACTIVE=local

# Server port to run the app
SERVER_PORT=8081

# API key used for securing endpoints
# (Each environment must override this)
API_KEY_SECRET=your-api-key-here

# Rate limiter configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_TIME_WINDOW=1m

# -------------------------------
# PostgreSQL Configuration
# -------------------------------
# Database name, user, and password
POSTGRES_DB=ragchatstorelocal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JDBC connection string
# Change host for non-local deployments
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ragchatstorelocal
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Hibernate configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# -------------------------------
# Redis Configuration
# -------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------------------
# Kafka Configuration
# -------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_CHAT_MESSAGES=chat_messages

# -------------------------------
# Observability / Logging
# -------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5001
KIBANA_URL=http://localhost:5601

# -------------------------------
# OpenTelemetry (Distributed Tracing)
# -------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=chatstorage-service

# -------------------------------
# Health / Monitoring
# -------------------------------
# Enable Spring Actuator health endpoint (always enabled by default)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env

# ============================================================
# NOTES:
# 1. Copy this file as .env.local, .env.dev, and .env.prod
# 2. Replace environment-specific values (DB names, API keys, etc.)
# 3. Keep this example tracked in GitHub for documentation
# 4. DO NOT commit real .env files containing secrets
# ============================================================
