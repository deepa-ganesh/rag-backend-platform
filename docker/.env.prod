# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
API_KEY_SECRET=${API_KEY_SECRET:-super-secure-prod-key}
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_TIME_WINDOW=1m

# PostgreSQL
POSTGRES_DB=rag_chat_prod
POSTGRES_USER=${POSTGRES_USER:-xdai_prod}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-ChangeThisStrong!}
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rag_chat_prod
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-xdai_prod}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-ChangeThisStrong!}
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_CHAT_MESSAGES=chat_messages_prod

# Observability
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5001
KIBANA_URL=http://kibana:5601
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=chatstorage-service-prod
